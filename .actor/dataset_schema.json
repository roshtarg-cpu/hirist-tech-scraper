{
  "$schema": "https://apify.com/schemas/v1/dataset.ide.json",
  "actorSpecification": 1,
  "fields": {
    "jobId": {
      "type": "integer",
      "title": "Job ID",
      "description": "Unique Hirist job identifier"
    },
    "title": {
      "type": "string",
      "title": "Job Title",
      "description": "Full job title including company name"
    },
    "url": {
      "type": "string",
      "title": "Job URL",
      "description": "Direct link to job posting on Hirist"
    },
    "company": {
      "type": "object",
      "title": "Company Details",
      "properties": {
        "name": {"type": "string"},
        "logo": {"type": "string"},
        "rating": {"type": "number"},
        "reviews": {"type": "integer"},
        "about": {"type": "string"},
        "founded": {"type": "string"},
        "employees": {"type": "string"},
        "headquarters": {"type": "string"},
        "industry": {"type": "string"}
      }
    },
    "experience": {
      "type": "object",
      "title": "Experience Required",
      "properties": {
        "min": {"type": "integer"},
        "max": {"type": "integer"}
      }
    },
    "salary": {
      "type": "object",
      "title": "Salary Range",
      "properties": {
        "min": {"type": "integer"},
        "max": {"type": "integer"},
        "hidden": {"type": "boolean"},
        "currency": {"type": "string"}
      }
    },
    "location": {
      "type": "array",
      "title": "Job Locations",
      "items": {"type": "string"}
    },
    "skills": {
      "type": "array",
      "title": "Required Skills",
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "mandatory": {"type": "boolean"}
        }
      }
    },
    "metadata": {
      "type": "object",
      "title": "Job Metadata",
      "properties": {
        "posted": {"type": "string"},
        "premium": {"type": "boolean"},
        "workFromHome": {"type": "boolean"},
        "confidential": {"type": "boolean"},
        "views": {"type": "integer"},
        "applications": {"type": "integer"},
        "category": {"type": "integer"}
      }
    },
    "description": {
      "type": "object",
      "title": "Job Description",
      "properties": {
        "html": {"type": "string"},
        "text": {"type": "string"}
      }
    },
    "recruiter": {
      "type": "object",
      "title": "Recruiter Info",
      "properties": {
        "name": {"type": "string"},
        "title": {"type": "string"},
        "lastActive": {"type": "string"}
      }
    },
    "scrapedAt": {
      "type": "string",
      "title": "Scraped At",
      "description": "ISO 8601 timestamp"
    }
  },
  "views": {
    "overview": {
      "title": "Job Overview",
      "transformation": {
        "fields": ["title", "company", "location", "experience", "skills"]
      },
      "display": {
        "component": "table",
        "properties": {
          "title": {
            "label": "Job Title",
            "format": "text"
          },
          "company": {
            "label": "Company",
            "format": "object"
          },
          "location": {
            "label": "Location",
            "format": "array"
          },
          "experience": {
            "label": "Experience",
            "format": "object"
          }
        }
      }
    }
  }
}
